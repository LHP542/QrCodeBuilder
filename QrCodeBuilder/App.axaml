<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:QrCodeBuilder"
             x:Class="QrCodeBuilder.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Kroste-Palette (voll — Card-basierter Look).
             Erklärung der Farb-Rollen: references/design.md → Farbpalette. -->
        <SolidColorBrush x:Key="KrosteBackgroundBrush" Color="#1A1D21" />
        <SolidColorBrush x:Key="KrosteTitleBarBrush" Color="#14161A" />
        <SolidColorBrush x:Key="KrosteSurfaceBrush" Color="#22262B" />
        <SolidColorBrush x:Key="KrosteCardBrush" Color="#1F2328" />
        <SolidColorBrush x:Key="KrosteAccentBrush" Color="#123E6B" />
        <SolidColorBrush x:Key="KrosteAccentHoverBrush" Color="#1B5390" />
        <SolidColorBrush x:Key="KrosteAccentSoftBrush" Color="#1E3A5C" />
        <SolidColorBrush x:Key="KrosteGoldBrush" Color="#E0B14C" />
        <SolidColorBrush x:Key="KrosteBorderBrush" Color="#2E343C" />
        <SolidColorBrush x:Key="KrosteBorderStrongBrush" Color="#3C444E" />
        <SolidColorBrush x:Key="KrosteMutedTextBrush" Color="#8A93A0" />
        <SolidColorBrush x:Key="KrosteSecondaryTextBrush" Color="#B7BEC7" />
        <SolidColorBrush x:Key="KrosteTextBrush" Color="#E4E7EC" />
        <SolidColorBrush x:Key="KrosteDangerBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="KrosteSuccessBrush" Color="#3AA55B" />
        <!-- Systemakzent des FluentTheme (Regler, Checkbox, Auswahl) auf die Kroste-
             Akzentlinie legen — sonst übernimmt er das Windows-Systemblau. -->
        <Color x:Key="SystemAccentColor">#1B5390</Color>
        <Color x:Key="SystemAccentColorDark1">#164878</Color>
        <Color x:Key="SystemAccentColorDark2">#123E6B</Color>
        <Color x:Key="SystemAccentColorDark3">#0D2E50</Color>
        <Color x:Key="SystemAccentColorLight1">#2A68AD</Color>
        <Color x:Key="SystemAccentColorLight2">#3A7CC4</Color>
        <Color x:Key="SystemAccentColorLight3">#5592D6</Color>
        <SolidColorBrush x:Key="KrosteWarningBrush" Color="#E0A030" />
        <!-- Untergrund der QR-Vorschau: hell, damit auch ein Code mit transparentem
             Hintergrund und dunklen Modulen sichtbar bleibt. -->
        <SolidColorBrush x:Key="QrPreviewBackdropBrush" Color="#F4F5F7" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- DataGrid nur einbinden, wenn das Paket referenziert ist:
             <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" /> -->

        <!-- ================================================================ -->
        <!-- Titelleiste (Kroste-Chrome-Standard)                              -->
        <!-- ================================================================ -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A2E33" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteDangerBrush}" />
        </Style>

        <!-- ================================================================ -->
        <!-- Buttons — konsistenter Basis-Look, Varianten via Klasse           -->
        <!-- ================================================================ -->
        <!-- Default: subtile Karte, dünner Border, Hover hebt sich ab.
             Sonst würde FluentTheme-Standard-Grau alles konkurrieren. -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A2F36" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderStrongBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#181B20" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Primäre Aktion: kräftiger Akzent, helle Schrift.
             WICHTIG: FluentTheme hat eine EINGEBAUTE Button.accent-Klasse
             (System-Akzent), die den ContentPresenter-Part einfärbt und einen
             Setter auf Button.Background überstimmt. Deshalb den Akzent DIREKT am
             ContentPresenter#PART_ContentPresenter setzen — sonst ist der Button
             System-blau statt projekt-akzentfarben (fällt nur auf, wenn der
             Projekt-Akzent nicht auch blau ist — siehe references/avalonia12.md). -->
        <Style Selector="Button.accent">
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteAccentBrush}" />
            <Setter Property="Foreground" Value="#F5F7FA" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KrosteAccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteAccentHoverBrush}" />
        </Style>

        <!-- Ghost: rein textlich, Hover bekommt subtiles Card-Background. -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteSecondaryTextBrush}" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A2F36" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Gefährliche Aktion (löschen/verwerfen): roter Hover-State. -->
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5A1F19" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteDangerBrush}" />
        </Style>

        <!-- ================================================================ -->
        <!-- Cards / Sektionen                                                 -->
        <!-- ================================================================ -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource KrosteCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="Border.card-flat">
            <Setter Property="Background" Value="{DynamicResource KrosteCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Section-Label: dünner Alu-Look, klein, sperrig, Grau.
             Für ALL-CAPS-Sektionsmarker wie "ARCHIV" / "WERKZEUGE". -->
        <Style Selector="TextBlock.section-label">
            <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource KrosteSecondaryTextBrush}" />
        </Style>

        <!-- Header-Titel: grosses Wort oben im Fenster (Gold). -->
        <Style Selector="TextBlock.h1">
            <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ================================================================ -->
        <!-- TextBox / ComboBox — dunkler, Fokus-Ring in Gold                  -->
        <!-- ================================================================ -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderStrongBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteGoldBrush}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteGoldBrush}" />
        </Style>

        <!-- ================================================================ -->
        <!-- ProgressBar — duenn, Gold                                         -->
        <!-- ================================================================ -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource KrosteGoldBrush}" />
            <Setter Property="Background" Value="#2A2F36" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!-- ================================================================
             DataGrid — cleaner Header, Row-Hover, Akzent-Selection.

             BEWUSST AUSKOMMENTIERT. DataGrid ist ein separates Paket
             (Avalonia.Controls.DataGrid), das dieses Template NICHT
             referenziert. Aktive Selektoren auf einen unbekannten Typ geben
             AVLN2000 ("Unable to resolve type DataGrid") — und zwar nur beim
             ERSTEN Build: ein zweiter Lauf ist gruen, weil die XAML-Aufgabe
             inkrementell ist. Lokal faellt das nach einem Retry nicht auf, der
             CI-Runner mit frischem Checkout ist dagegen jedes Mal rot.

             Zum Aktivieren: Paket referenzieren, den StyleInclude oben
             einkommentieren und diesen Block hier auskommentieren.

             Achtung: AlternatingRowBackground gibt es in Avalonia 12 NICHT
             (AVLN2000). Alternierende Zeilen ggf. via nth-child(odd).
             ================================================================
         ================================================================ 
         DataGrid — cleaner Header, Row-Hover, Akzent-Selection            
         Nur wirksam, wenn Avalonia.Controls.DataGrid referenziert und     
         der StyleInclude oben aktiviert ist.                              
         Achtung: AlternatingRowBackground gibt es in Avalonia 12 NICHT    
         (AVLN2000). Alternierende Zeilen ggf. via nth-child(odd).        
         ================================================================ 
        <Style Selector="DataGrid">
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="34" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A1D22" />
            <Setter Property="Foreground" Value="{DynamicResource KrosteMutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#262B31" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource KrosteAccentSoftBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="12,6" />
        </Style>
             -->

        <!-- ================================================================ -->
        <!-- QR-Code-Builder: Farbfelder, Hex-Eingabe, Warnhinweis             -->
        <!-- ================================================================ -->
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
        </Style>
        <Style Selector="Border.swatch">
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.warning">
            <Setter Property="Background" Value="{DynamicResource KrosteSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KrosteWarningBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Border.warning TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource KrosteWarningBrush}" />
        </Style>

        <!-- ================================================================ -->
        <!-- Divider (vertikal + horizontal)                                   -->
        <!-- ================================================================ -->
        <Style Selector="Rectangle.divider-v">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Rectangle.divider-h">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource KrosteBorderBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Application.Styles>
</Application>
