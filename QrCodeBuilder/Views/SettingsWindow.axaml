<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:QrCodeBuilder.Views"
        xmlns:controls="using:QrCodeBuilder.Controls"
        xmlns:loc="using:QrCodeBuilder.Localization"
        xmlns:vm="using:QrCodeBuilder.ViewModels"
        x:Class="QrCodeBuilder.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_Settings}"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_Settings}" />

        <StackPanel Margin="22" Spacing="14">
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Settings_Section_UiLanguage}" Classes="section-label" />
                    <ComboBox ItemsSource="{Binding Cultures}"
                              SelectedItem="{Binding SelectedCulture}"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Text="{loc:Tr Settings_UiLanguage_Hint}" Classes="muted"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Settings_Section_Updates}" Classes="section-label" />
                    <TextBox Text="{Binding UpdateChannel}" FontSize="12" />
                    <TextBlock Text="{loc:Tr Settings_UpdateChannel_Hint}" Classes="muted"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button Classes="ghost" Content="{loc:Tr Common_Close}"
                    HorizontalAlignment="Right"
                    Click="OnClose" />
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
