<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:QrCodeBuilder.Views"
        xmlns:controls="using:QrCodeBuilder.Controls"
        xmlns:loc="using:QrCodeBuilder.Localization"
        x:Class="QrCodeBuilder.Views.UpdatePromptWindow"
        Width="500" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_Update}"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_Update}" />

        <StackPanel Margin="22" Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock x:Name="Headline" Classes="h2" TextWrapping="Wrap" />
                <TextBlock x:Name="Body" Classes="secondary" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>

            <Border Classes="card" x:Name="NotesCard" IsVisible="False">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr Update_Notes}" Classes="section-label" />
                    <!-- Rechter Rand für den Rollbalken: Avalonia legt ihn ÜBER den Inhalt. -->
                    <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock x:Name="Notes" TextWrapping="Wrap" FontSize="12"
                                             Margin="0,0,14,0" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="Progress" IsVisible="False" Minimum="0" Maximum="1" />
            <TextBlock x:Name="Status" Classes="muted" FontSize="11" IsVisible="False" />

            <!-- WrapPanel statt StackPanel: lange Beschriftungen brechen um statt abgeschnitten zu werden. -->
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Classes="ghost" Margin="0,0,10,0" Content="{loc:Tr Common_Later}" />
                <Button x:Name="InstallButton" Classes="accent" Content="{loc:Tr Update_Install}" />
            </WrapPanel>
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
