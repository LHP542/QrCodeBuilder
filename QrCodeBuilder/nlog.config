<?xml version="1.0" encoding="utf-8"?>
<!-- Kroste-Standard: So viel wie möglich loggen. Datei = Trace aufwärts (alles),
     Konsole = Info aufwärts. Secrets werden über den masked-Layout-Renderer
     maskiert (MaskingLayoutRenderer im Projekt registrieren, siehe SKILL.md).

     ACHTUNG bei internalLogFile: das ist ein simpler Dateiname, KEIN Layout.
     Ein ${specialfolder:...} wird dort nicht aufgelöst, NLog legt stattdessen
     ein Verzeichnis mit genau diesem Namen an. Erlaubt sind nur ${basedir},
     ${currentdir}, ${tempdir} und %ENVVAR%. Der tempdir-Pfad ist zudem immer
     schreibbar — das BaseDirectory ist es beim laufenden AppImage nicht.

     Aus demselben Grund liegen die Logdateien NICHT relativ (logs/ neben der
     Exe), sondern unter LocalApplicationData: %LOCALAPPDATA%\QrCodeBuilder\logs
     bzw. ~/.local/share/QrCodeBuilder/logs. Im fileName-Layout ist
     ${specialfolder} erlaubt, nur internalLogFile kennt keine Renderer. -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${tempdir}/QrCodeBuilder/nlog-internal.log">

  <targets>
    <target xsi:type="File" name="file"
            fileName="${specialfolder:folder=LocalApplicationData}/QrCodeBuilder/logs/QrCodeBuilder.log"
            archiveFileName="${specialfolder:folder=LocalApplicationData}/QrCodeBuilder/logs/archive/QrCodeBuilder.{#}.log"
            archiveEvery="Day"
            maxArchiveFiles="14"
            layout="${longdate}|${level:uppercase=true}|${logger}|${masked:inner=${message}}${onexception:inner=|${exception:format=tostring}}" />

    <target xsi:type="ColoredConsole" name="console"
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${masked:inner=${message}}${onexception:inner=|${exception:format=message}}" />
  </targets>

  <rules>
    <!-- Alles in die Datei — Trace ist Absicht, nicht Versehen -->
    <logger name="*" minlevel="Trace" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
