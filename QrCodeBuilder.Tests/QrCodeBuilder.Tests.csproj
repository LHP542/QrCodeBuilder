<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit.v3 generiert einen eigenen Entry-Point: das Testprojekt ist eine Exe.
         Ohne das bricht der Build mit "xUnit.net v3 test projects must be executable". -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Test.Sdk und xunit.runner.visualstudio gehören zum alten
         VSTest-Pfad, den das .NET-10-SDK nicht mehr unterstützt, also weglassen. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Notbremse gegen einen Test, der in einer allokierenden Endlosschleife
         hängt: der Lauf endet als OutOfMemoryException statt den Rechner leerzuziehen. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="0x40000000" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../QrCodeBuilder/QrCodeBuilder.csproj" />
  </ItemGroup>
</Project>
