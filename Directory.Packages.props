<Project>
  <!-- Central Package Management: EINZIGER Ort für Paketversionen.
       Stand 2026-10-05.

       ACHTUNG Arbeitslaptop: Der Firmen-Proxy blockt .nupkg-Downloads (403,
       Inhaltsfilter). Die Versionen hier entsprechen deshalb dem, was im
       Offline-Feed C:\NuGet-Local liegt, nicht dem Neuesten auf nuget.org
       (dort gab es bereits Avalonia 12.1.3, NLog 6.2.1, xunit.v3 4.0.1,
       MinVer 8.0.0). Wer anhebt, muss das Paket vorher in den Offline-Feed
       legen, sonst ist der Restore lokal kaputt, während die CI grün bleibt. -->
  <ItemGroup>
    <!-- Avalonia 12.1.1 (neueste im Offline-Feed).
         DiagnosticsSupport folgt NICHT der Avalonia-Version (eigene 2.x-Reihe)! -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Nur Debug-Builds referenzieren dieses Paket (DevTools) -->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <!-- Linux DBus/Tray. Die Version folgt dem transitiven Zug von
         Avalonia.FreeDesktop 12.1.1 (= 0.94.1), NICHT der Höchstversion.
         Der Verweis steht bewusst explizit in QrCodeBuilder.csproj, sonst
         wäre dieser Eintrag ohne transitives Pinning wirkungslos. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />

    <!-- QR-Erzeugung (MIT). Genutzt wird nur QRCodeGenerator (Kodierung zur
         Modulmatrix); PNG und SVG zeichnet QrRenderer selbst, damit nichts
         an System.Drawing hängt. -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />

    <!-- MVVM & DI -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />

    <!-- Logging -->
    <PackageVersion Include="NLog" Version="6.2.0" />

    <!-- Versionierung -->
    <PackageVersion Include="MinVer" Version="7.0.0" />

    <!-- Tests (xunit.v3, NICHT das alte "xunit"-Paket, v2 ist deprecated);
         FluentAssertions NICHT auf 8.x heben (Xceed-Lizenz) -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
  </ItemGroup>
</Project>
